---
import MainLayout from '../layouts/MainLayout.astro';
import PageContainer from '../components/layout/PageContainer.astro';
import LiveAuthBridge from '../components/community/LiveAuthBridge';
import { getGlobalSearchIndex } from '../lib/editorial';

const searchItems = await getGlobalSearchIndex();
---

<MainLayout
  title="Sign In"
  description="Sign in to Checkpoint Daily to cast weekly character battle votes and represent your faction."
  showAnnouncement={false}
  searchItems={searchItems}
>
  <PageContainer className="py-12 lg:py-20">
    <LiveAuthBridge client:load mode="login" />
  </PageContainer>
</MainLayout>
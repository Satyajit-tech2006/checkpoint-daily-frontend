---
import MainLayout from '../layouts/MainLayout.astro';
import PageContainer from '../components/layout/PageContainer.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import SectionHeading from '../components/editorial/SectionHeading.astro';
import TagBadge from '../components/editorial/TagBadge.astro';
import { getGlobalSearchIndex } from '../lib/editorial';

const searchItems = await getGlobalSearchIndex();
---

<MainLayout
  title="Editorial & Fact-Checking Policy"
  description="How Checkpoint Daily verifies leaks, labels Rumour Radar reports, and maintains editorial independence."
  searchItems={searchItems}
>
  <PageContainer className="py-8 lg:py-12 space-y-10">
    <Breadcrumbs items={[{ label: 'Editorial Policy' }]} />

    <div class="max-w-3xl space-y-8">
      <SectionHeading
        eyebrow="Standards & Ethics"
        title="Editorial & Fact Policy"
        subtitle="Clear sourcing, transparent corrections, and strict separation between confirmed facts and community speculation."
      />

      <div class="space-y-4">
        <h2 class="font-display text-xl font-black uppercase text-white">
          1. Rumour Radar Classification Standards
        </h2>
        <div class="space-y-3">
          <div class="rounded-xl border border-zinc-800 bg-[#121216] p-4 space-y-1.5">
            <TagBadge label="Confirmed" variant="confirmed" size="md" />
            <p class="text-sm text-zinc-300">
              Backed by official publisher trailers, press releases, regulatory filings, or direct primary-source documentation.
            </p>
          </div>
          <div class="rounded-xl border border-zinc-800 bg-[#121216] p-4 space-y-1.5">
            <TagBadge label="Unverified" variant="unverified" size="md" />
            <p class="text-sm text-zinc-300">
              Derived from patent filings, anonymous insider claims, or datamined strings that lack official confirmation.
            </p>
          </div>
          <div class="rounded-xl border border-zinc-800 bg-[#121216] p-4 space-y-1.5">
            <TagBadge label="Debunked" variant="debunked" size="md" />
            <p class="text-sm text-zinc-300">
              Proven false via forensic asset analysis, metadata inspection, or official refutation.
            </p>
          </div>
        </div>
      </div>

      <div class="space-y-3 text-sm leading-relaxed text-zinc-300">
        <h2 class="font-display text-xl font-black uppercase text-white">
          2. Corrections & Updates
        </h2>
        <p>
          When new official footage or documentation alters the status of a previously published report, we update the article header badge immediately and append a timestamped correction note explaining what changed.
        </p>
      </div>
    </div>
  </PageContainer>
</MainLayout>
---
import MainLayout from '../layouts/MainLayout.astro';
import PageContainer from '../components/layout/PageContainer.astro';
import AuthForm from '../components/community/AuthForm';
import { getGlobalSearchIndex } from '../lib/editorial';

const searchItems = await getGlobalSearchIndex();
---

<MainLayout
  title="Create Account"
  description="Create a Checkpoint Daily account to join a permanent Leonida character faction and vote in weekly clashes."
  showAnnouncement={false}
  searchItems={searchItems}
>
  <PageContainer className="py-12 lg:py-20">
    <AuthForm client:load mode="register" />
  </PageContainer>
</MainLayout>
---
import MainLayout from '../../layouts/MainLayout.astro';
import PageContainer from '../../components/layout/PageContainer.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionHeading from '../../components/editorial/SectionHeading.astro';
import TeamMembershipButton from '../../components/community/TeamMembershipButton';
import LeaderboardTable from '../../components/community/LeaderboardTable.astro';
import {
  FACTION_TEAMS,
  LEADERBOARD_STANDINGS,
  getAllCharacters,
  getGlobalSearchIndex,
} from '../../lib/editorial';

export function getStaticPaths() {
  return FACTION_TEAMS.map((team) => ({
    params: { slug: team.slug },
    props: { team },
  }));
}

const { team } = Astro.props;
const [characters, searchItems] = await Promise.all([
  getAllCharacters(),
  getGlobalSearchIndex(),
]);

const leaderCharacter = characters.find(
  (c) => c.name.toLowerCase() === team.characterName.toLowerCase()
);
const teamRank = LEADERBOARD_STANDINGS.find((e) => e.teamId === team.id)?.rank ?? 1;
---

<MainLayout
  title={`${team.name} — Faction Headquarters`}
  description={team.description}
  ogImage={team.characterImage}
  searchItems={searchItems}
>
  <PageContainer className="py-8 lg:py-12 space-y-10">
    <Breadcrumbs
      items={[
        { label: 'Faction Teams', href: '/teams' },
        { label: team.name },
      ]}
    />

    <!-- Faction Hero Banner -->
    <section class="overflow-hidden rounded-2xl border border-zinc-800 bg-[#121216]">
      <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:p-10">
        <!-- Character Emblem (4 cols) -->
        <div class="lg:col-span-4">
          <div class="mx-auto max-w-xs overflow-hidden rounded-xl border border-zinc-700 bg-zinc-900 shadow-2xl">
            <img
              src={team.characterImage}
              alt={team.characterName}
              class="aspect-[4/5] w-full object-cover object-top"
            />
          </div>
        </div>

        <!-- Faction Intel & Join CTA (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="rounded border border-cyan-500/30 bg-cyan-500/15 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-cyan-400">
                Season Rank #{teamRank}
              </span>
              <span class="rounded border border-amber-500/30 bg-amber-500/15 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-amber-400">
                Led by {team.characterName}
              </span>
            </div>

            <h1 class="font-display text-3xl font-black uppercase tracking-tight text-white sm:text-5xl">
              {team.name}
            </h1>
            <p class="text-sm font-bold italic text-amber-400">&ldquo;{team.motto}&rdquo;</p>
          </div>

          <p class="max-w-2xl text-base leading-relaxed text-zinc-300">
            {team.description}
          </p>

          <!-- Telemetry Grid -->
          <div class="grid grid-cols-3 gap-4 rounded-xl border border-zinc-800 bg-zinc-950/70 p-4 text-center sm:max-w-lg">
            <div>
              <p class="font-display text-2xl font-black text-white">
                {team.memberCount.toLocaleString()}
              </p>
              <p class="text-[11px] uppercase tracking-wider text-zinc-500">Sworn Members</p>
            </div>
            <div>
              <p class="font-display text-2xl font-black text-cyan-400">
                {team.totalPoints.toLocaleString()}
              </p>
              <p class="text-[11px] uppercase tracking-wider text-zinc-500">Season Score</p>
            </div>
            <div>
              <p class="font-display text-2xl font-black text-amber-400">
                {team.weeklyWins}
              </p>
              <p class="text-[11px] uppercase tracking-wider text-zinc-500">Arena Wins</p>
            </div>
          </div>

          <!-- Action Bar -->
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:max-w-lg">
            <div class="flex-1">
              <TeamMembershipButton
                client:load
                teamId={team.id}
                teamName={team.name}
                userCurrentTeamId={null}
                isAuthenticated={false}
              />
            </div>

            {leaderCharacter && (
              <a
                href={`/characters/${leaderCharacter.slug}`}
                class="inline-flex h-10 items-center justify-center rounded-lg border border-zinc-700 bg-zinc-900 px-4 text-xs font-bold uppercase tracking-wider text-zinc-200 transition-colors hover:border-zinc-600 hover:text-white"
              >
                Read {team.characterName} Dossier
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Current Standings Context -->
    <section class="space-y-6">
      <SectionHeading
        accent="community"
        eyebrow="Live Telemetry"
        title="Season Standings Comparison"
        actionLabel="Enter Weekly Arena"
        actionHref="/vote"
      />
      <LeaderboardTable entries={LEADERBOARD_STANDINGS} highlightTeamId={team.id} />
    </section>
  </PageContainer>
</MainLayout>
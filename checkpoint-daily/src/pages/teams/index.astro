---
import MainLayout from '../../layouts/MainLayout.astro';
import PageContainer from '../../components/layout/PageContainer.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionHeading from '../../components/editorial/SectionHeading.astro';
import TeamCard from '../../components/community/TeamCard.astro';
import { FACTION_TEAMS, getGlobalSearchIndex } from '../../lib/editorial';

const searchItems = await getGlobalSearchIndex();
---

<MainLayout
  title="Faction Teams"
  description="Choose your permanent Leonida character faction, earn seasonal points through weekly arena votes, and climb the global leaderboard."
  searchItems={searchItems}
>
  <PageContainer className="py-8 lg:py-12 space-y-10">
    <Breadcrumbs items={[{ label: 'Faction Teams' }]} />

    <SectionHeading
      accent="community"
      eyebrow="Community Allegiance"
      title="Leonida Faction Teams"
      subtitle="Pledge permanent loyalty to one character syndicate. Every weekly ballot you cast adds directly to your faction's seasonal score."
      actionLabel="View Global Standings"
      actionHref="/leaderboard"
    />

    <!-- Allegiance Rules Callout -->
    <div class="grid grid-cols-1 gap-4 rounded-2xl border border-zinc-800 bg-[#121216] p-5 sm:p-6 md:grid-cols-3">
      <div class="space-y-1">
        <span class="text-[11px] font-bold uppercase tracking-widest text-cyan-400">01 &bull; Permanent Lock</span>
        <h3 class="font-display text-base font-bold text-white">One Faction Per Season</h3>
        <p class="text-xs leading-relaxed text-zinc-400">
          Once you lock in your allegiance, you cannot switch sides mid-season. Choose your syndicate carefully.
        </p>
      </div>
      <div class="space-y-1">
        <span class="text-[11px] font-bold uppercase tracking-widest text-amber-400">02 &bull; Weekly Ballots</span>
        <h3 class="font-display text-base font-bold text-white">+10 Faction Points Per Vote</h3>
        <p class="text-xs leading-relaxed text-zinc-400">
          Every verified vote in the Weekly Character Clash earns points for your team—even when your leader isn&apos;t in the ring.
        </p>
      </div>
      <div class="space-y-1">
        <span class="text-[11px] font-bold uppercase tracking-widest text-emerald-400">03 &bull; Arena Victories</span>
        <h3 class="font-display text-base font-bold text-white">+500 Bonus on Matchup Wins</h3>
        <p class="text-xs leading-relaxed text-zinc-400">
          When your faction&apos;s character wins a weekly head-to-head battle, your syndicate banks a major leaderboard bonus.
        </p>
      </div>
    </div>

    <!-- Teams Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {FACTION_TEAMS.map((team) => (
        <TeamCard
          team={team}
          userCurrentTeamId={null}
          isAuthenticated={false}
        />
      ))}
    </div>
  </PageContainer>
</MainLayout>
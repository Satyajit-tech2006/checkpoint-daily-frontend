---
import MainLayout from '../layouts/MainLayout.astro';
import PageContainer from '../components/layout/PageContainer.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import SectionHeading from '../components/editorial/SectionHeading.astro';
import WeeklyWinnerCard from '../components/community/WeeklyWinnerCard.astro';
import LeaderboardTable from '../components/community/LeaderboardTable.astro';
import { LEADERBOARD_STANDINGS, getGlobalSearchIndex } from '../lib/editorial';

const searchItems = await getGlobalSearchIndex();
---

<MainLayout
  title="Global Faction Leaderboard"
  description="Live seasonal rankings, weekly arena points, and faction member counts across Checkpoint Daily."
  searchItems={searchItems}
>
  <PageContainer className="py-8 lg:py-12 space-y-10">
    <Breadcrumbs items={[{ label: 'Leaderboard' }]} />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <SectionHeading
          accent="community"
          eyebrow="Season 1 Rankings"
          title="Global Faction Leaderboard"
          subtitle="Aggregated in real time from verified community ballots and weekly arena victories."
          actionLabel="Cast This Week's Vote"
          actionHref="/vote"
        />
      </div>

      <div class="lg:col-span-5">
        <WeeklyWinnerCard
          weekNumber={13}
          winnerName="Lucia Caminos"
          teamName="Team Lucia"
          teamSlug="team-lucia"
          characterImage="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=900&q=80"
          winPercentage={54}
          totalVotes={11240}
        />
      </div>
    </div>

    <!-- Main Standings Table -->
    <LeaderboardTable entries={LEADERBOARD_STANDINGS} />

    <!-- Transparent Scoring Mechanics -->
    <div class="rounded-xl border border-zinc-800/90 bg-[#121216] p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-zinc-400">
      <div>
        <strong class="text-zinc-200 uppercase tracking-wider">Scoring Integrity:</strong>
        <span class="ml-1.5">
          All faction scores are computed atomically via PostgreSQL triggers on verified ballots (+10 pts/vote, +500 pts/weekly win).
        </span>
      </div>
      <a
        href="/teams"
        class="shrink-0 font-bold uppercase tracking-wider text-cyan-400 hover:text-cyan-300"
      >
        Join a Faction &rarr;
      </a>
    </div>
  </PageContainer>
</MainLayout>
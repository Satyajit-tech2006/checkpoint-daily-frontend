---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageContainer from '../../components/layout/PageContainer.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import TagBadge from '../../components/editorial/TagBadge.astro';
import AuthorInfo from '../../components/editorial/AuthorInfo.astro';
import TrendingStories from '../../components/editorial/TrendingStories.astro';
import SectionHeading from '../../components/editorial/SectionHeading.astro';
import ArticleGrid from '../../components/editorial/ArticleGrid.astro';
import Newsletter from '../../components/editorial/Newsletter';
import { getAllArticles, getGlobalSearchIndex } from '../../lib/editorial';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

const [allArticles, searchItems] = await Promise.all([
  getAllArticles(),
  getGlobalSearchIndex(),
]);

const relatedArticles = allArticles
  .filter((a) => a.slug !== entry.slug)
  .slice(0, 3);

const rumourDescriptions = {
  confirmed: 'Verified against official trailers, filings, or primary-source documentation.',
  unverified: 'Circulating in community reports or patents; lacks direct gameplay confirmation.',
  debunked: 'Forensically disproven or traced to fabricated/misattributed assets.',
};
---

<MainLayout
  title={data.title}
  description={data.excerpt}
  ogImage={data.coverImage}
  searchItems={searchItems}
>
  <article class="py-8 lg:py-12">
    <PageContainer className="space-y-8">
      <Breadcrumbs
        items={[
          { label: data.category, href: `/${data.categorySlug}` },
          { label: data.title },
        ]}
      />

      <!-- Article Header -->
      <header class="max-w-4xl space-y-5">
        <div class="flex flex-wrap items-center gap-2.5">
          <TagBadge
            label={data.category}
            href={`/${data.categorySlug}`}
            variant="category"
            size="md"
          />
          {data.rumourStatus && (
            <TagBadge
              label={`Rumour Radar: ${data.rumourStatus}`}
              variant={data.rumourStatus}
              size="md"
            />
          )}
        </div>

        <h1 class="font-display text-3xl font-black leading-tight tracking-tight text-white sm:text-5xl">
          {data.title}
        </h1>

        <p class="text-base sm:text-xl leading-relaxed text-zinc-300">
          {data.excerpt}
        </p>

        <div class="pt-2">
          <AuthorInfo
            author={data.author}
            publishedAt={data.publishedAt}
            readingTime={data.readingTime}
            variant="byline"
          />
        </div>
      </header>

      <!-- Hero Cover Media -->
      <figure class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900">
        <img
          src={data.coverImage}
          alt={data.coverAlt}
          class="aspect-[21/9] w-full object-cover"
        />
        <figcaption class="border-t border-zinc-800/80 bg-zinc-950/90 px-4 py-2.5 text-xs text-zinc-400">
          {data.coverAlt} &mdash; Checkpoint Daily Editorial Desk
        </figcaption>
      </figure>

      <!-- Main 12-Column Editorial Layout -->
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 pt-2">
        <!-- Body Copy (8 cols) -->
        <div class="lg:col-span-8 space-y-8">
          {data.rumourStatus && (
            <div class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="space-y-1">
                <p class="text-xs font-bold uppercase tracking-widest text-zinc-400">
                  Rumour Radar Verdict
                </p>
                <p class="text-sm text-zinc-200">{rumourDescriptions[data.rumourStatus]}</p>
              </div>
              <TagBadge
                label={data.rumourStatus}
                variant={data.rumourStatus}
                size="md"
                className="shrink-0 self-start sm:self-center"
              />
            </div>
          )}

          <!-- Styled MDX Prose -->
          <div
            class="space-y-6 text-base sm:text-[17px] leading-[1.8] text-zinc-300
                   [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-black [&_h2]:uppercase [&_h2]:tracking-tight [&_h2]:text-white
                   [&_h3]:mt-7 [&_h3]:mb-2 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-zinc-100
                   [&_strong]:font-bold [&_strong]:text-white
                   [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2
                   [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2
                   [&_blockquote]:border-l-2 [&_blockquote]:border-amber-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-zinc-200"
          >
            <Content />
          </div>

          <!-- Topic Tags -->
          {data.tags.length > 0 && (
            <div class="border-t border-zinc-800 pt-6 flex flex-wrap items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 mr-1">
                Filed Under:
              </span>
              {data.tags.map((tag) => (
                <TagBadge label={`#${tag}`} size="md" />
              ))}
            </div>
          )}

          <!-- Full Journalist Bio Box -->
          <AuthorInfo author={data.author} variant="bio-box" />
        </div>

        <!-- Sticky Wire Sidebar (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
          <div class="lg:sticky lg:top-24 space-y-6">
            <TrendingStories articles={allArticles} title="Latest Wire" />
          </div>
        </div>
      </div>
    </PageContainer>
  </article>

  <!-- Related Coverage -->
  {relatedArticles.length > 0 && (
    <section class="border-t border-zinc-900 bg-zinc-950/60 py-12 lg:py-16">
      <PageContainer className="space-y-8">
        <SectionHeading
          eyebrow="Continue Reading"
          title="Related Dispatches"
          actionLabel="View All News"
          actionHref="/news"
        />
        <ArticleGrid articles={relatedArticles} layout="grid-3" />
      </PageContainer>
    </section>
  )}

  <section class="py-12">
    <PageContainer>
      <Newsletter client:visible />
    </PageContainer>
  </section>
</MainLayout>
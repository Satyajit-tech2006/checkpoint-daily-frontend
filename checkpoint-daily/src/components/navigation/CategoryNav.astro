---
import type { CategoryItem } from '../../types';
import { cn } from '../../lib/utils';

interface Props {
  categories: CategoryItem[];
  activeSlug: string;
  className?: string;
}

const { categories, activeSlug, className } = Astro.props;
---

<nav
  aria-label="Category Filter"
  class={cn('flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar', className)}
>
  {categories.map((cat) => {
    const isActive = cat.slug === activeSlug;
    return (
      <a
        href={cat.href}
        aria-current={isActive ? 'true' : undefined}
        class={cn(
          'inline-flex shrink-0 items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-bold uppercase tracking-wider transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500',
          isActive
            ? 'border-amber-500 bg-amber-500 text-zinc-950 shadow-sm'
            : 'border-zinc-800 bg-zinc-900/70 text-zinc-400 hover:border-zinc-700 hover:text-zinc-100'
        )}
      >
        <span>{cat.label}</span>
        {typeof cat.count === 'number' && (
          <span
            class={cn(
              'rounded-full px-1.5 py-0.2 text-[10px]',
              isActive ? 'bg-zinc-950/20 text-zinc-950' : 'bg-zinc-800 text-zinc-400'
            )}
          >
            {cat.count}
          </span>
        )}
      </a>
    );
  })}
</nav>
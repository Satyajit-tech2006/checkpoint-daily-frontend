---
import type { BreadcrumbItem } from '../../types';
import { cn } from '../../lib/utils';

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={cn('text-xs text-zinc-400', className)}>
  <ol class="flex flex-wrap items-center gap-1.5">
    <li>
      <a
        href="/"
        class="font-medium transition-colors hover:text-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded"
      >
        Home
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          <span aria-hidden="true" class="text-zinc-600">/</span>
          {isLast || !item.href ? (
            <span
              aria-current={isLast ? 'page' : undefined}
              class="font-semibold text-zinc-200 line-clamp-1 max-w-[220px] sm:max-w-none"
            >
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="font-medium transition-colors hover:text-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
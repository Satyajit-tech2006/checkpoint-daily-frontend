---
import type { CharacterProfile } from '../../types';

interface Props {
  character: CharacterProfile;
  teamHref?: string;
}

const { character, teamHref } = Astro.props;
---

<section class="relative overflow-hidden rounded-2xl border border-zinc-800 bg-[#121216]">
  <!-- Ambient Background Banner -->
  {character.bannerImage && (
    <div aria-hidden="true" class="absolute inset-0 opacity-20">
      <img
        src={character.bannerImage}
        alt=""
        class="h-full w-full object-cover blur-sm"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/90 to-zinc-950/70" />
    </div>
  )}

  <div class="relative z-10 grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:p-10">
    <!-- Portrait Frame (4 cols) -->
    <div class="lg:col-span-4">
      <div class="mx-auto max-w-xs overflow-hidden rounded-xl border border-zinc-700/80 bg-zinc-900 shadow-2xl">
        <img
          src={character.portraitImage}
          alt={character.name}
          class="aspect-[4/5] w-full object-cover object-top"
        />
      </div>
    </div>

    <!-- Dossier Intel (8 cols) -->
    <div class="lg:col-span-8 space-y-6">
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="rounded border border-cyan-500/30 bg-cyan-500/15 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-cyan-400">
            {character.faction}
          </span>
          <span class="rounded border border-zinc-700 bg-zinc-900 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-zinc-300">
            Status: {character.status}
          </span>
        </div>

        <h1 class="font-display text-3xl font-black uppercase tracking-tight text-white sm:text-5xl">
          {character.name}
        </h1>
        {character.alias && (
          <p class="text-sm font-semibold uppercase tracking-widest text-amber-400">
            Known Alias: &ldquo;{character.alias}&rdquo;
          </p>
        )}
      </div>

      <p class="max-w-2xl text-base leading-relaxed text-zinc-300">
        {character.bio}
      </p>

      <!-- Key Dossier Grid -->
      <dl class="grid grid-cols-2 gap-4 border-y border-zinc-800/90 py-4 sm:grid-cols-3">
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Primary Role</dt>
          <dd class="mt-1 text-sm font-bold text-white">{character.role}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Base of Operations</dt>
          <dd class="mt-1 text-sm font-bold text-white">{character.location}</dd>
        </div>
        {teamHref && (
          <div class="col-span-2 sm:col-span-1 flex items-center sm:justify-end">
            <a
              href={teamHref}
              class="inline-flex items-center justify-center rounded-lg bg-cyan-500 px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-950 transition-colors hover:bg-cyan-400"
            >
              View Faction Team &rarr;
            </a>
          </div>
        )}
      </dl>

      <!-- Optional Attribute Telemetry -->
      {character.stats && (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {Object.entries(character.stats).map(([key, val]) => (
            <div class="space-y-1.5">
              <div class="flex justify-between text-xs font-bold uppercase tracking-wider">
                <span class="text-zinc-400">{key}</span>
                <span class="text-cyan-400">{val}/100</span>
              </div>
              <div
                role="progressbar"
                aria-label={key}
                aria-valuenow={val}
                aria-valuemin={0}
                aria-valuemax={100}
                class="h-2 w-full overflow-hidden rounded-full bg-zinc-800"
              >
                <div
                  class="h-full rounded-full bg-cyan-500"
                  style={`width: ${Math.min(100, Math.max(0, val))}%`}
                />
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
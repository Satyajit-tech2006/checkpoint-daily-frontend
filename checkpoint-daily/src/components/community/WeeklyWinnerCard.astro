---
interface Props {
  weekNumber: number;
  winnerName: string;
  teamName: string;
  teamSlug: string;
  characterImage: string;
  winPercentage: number;
  totalVotes: number;
}

const {
  weekNumber,
  winnerName,
  teamName,
  teamSlug,
  characterImage,
  winPercentage,
  totalVotes,
} = Astro.props;
---

<aside
  aria-label={`Week ${weekNumber} Champion`}
  class="relative overflow-hidden rounded-2xl border border-amber-500/40 bg-[#121216] p-5 sm:p-6"
>
  <div class="flex flex-col sm:flex-row sm:items-center gap-5">
    <div class="relative h-24 w-24 shrink-0 overflow-hidden rounded-xl border-2 border-amber-500 bg-zinc-900">
      <img
        src={characterImage}
        alt={winnerName}
        loading="lazy"
        class="h-full w-full object-cover object-top"
      />
    </div>

    <div class="flex-1 space-y-1.5">
      <div class="inline-flex items-center gap-1.5 rounded bg-amber-500/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-amber-400 border border-amber-500/30">
        <span>Week {weekNumber} Arena Champion</span>
      </div>

      <h3 class="font-display text-2xl font-black uppercase tracking-tight text-white">
        {winnerName}
      </h3>

      <p class="text-xs text-zinc-400">
        Victory for{' '}
        <a href={`/teams/${teamSlug}`} class="font-bold text-cyan-400 hover:underline">
          {teamName}
        </a>{' '}
        with <strong class="text-white">{winPercentage}%</strong> of {totalVotes.toLocaleString()} ballots.
      </p>
    </div>
  </div>
</aside>
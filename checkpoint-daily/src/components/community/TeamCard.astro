---
import type { CharacterTeam } from '../../types';
import TeamMembershipButton from './TeamMembershipButton';

interface Props {
  team: CharacterTeam;
  userCurrentTeamId?: string | null;
  isAuthenticated?: boolean;
}

const {
  team,
  userCurrentTeamId = null,
  isAuthenticated = false,
} = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-xl border border-zinc-800/90 bg-[#121216] transition-colors hover:border-zinc-700">
  <!-- Header Artwork -->
  <div class="relative h-44 w-full overflow-hidden bg-zinc-900">
    <img
      src={team.characterImage}
      alt={team.characterName}
      loading="lazy"
      class="h-full w-full object-cover object-top"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-[#121216] via-[#121216]/50 to-transparent"
    />
    <div class="absolute bottom-3 left-5 right-5">
      <span class="text-[10px] font-bold uppercase tracking-widest text-cyan-400">
        Representing {team.characterName}
      </span>
      <h3 class="font-display text-2xl font-black uppercase tracking-tight text-white">
        <a href={`/teams/${team.slug}`} class="hover:text-cyan-300 transition-colors">
          {team.name}
        </a>
      </h3>
    </div>
  </div>

  <!-- Body & Telemetry -->
  <div class="flex flex-1 flex-col justify-between p-5 pt-3 space-y-5">
    <div class="space-y-2">
      <p class="text-xs font-bold italic text-amber-400">&ldquo;{team.motto}&rdquo;</p>
      <p class="line-clamp-2 text-sm leading-relaxed text-zinc-400">{team.description}</p>
    </div>

    <!-- Stats Strip -->
    <div class="grid grid-cols-3 divide-x divide-zinc-800 rounded-lg border border-zinc-800/80 bg-zinc-950/60 py-2.5 text-center">
      <div>
        <p class="font-display text-base font-black text-white">
          {team.memberCount.toLocaleString()}
        </p>
        <p class="text-[10px] uppercase tracking-wider text-zinc-500">Members</p>
      </div>
      <div>
        <p class="font-display text-base font-black text-cyan-400">
          {team.totalPoints.toLocaleString()}
        </p>
        <p class="text-[10px] uppercase tracking-wider text-zinc-500">Points</p>
      </div>
      <div>
        <p class="font-display text-base font-black text-amber-400">
          {team.weeklyWins}
        </p>
        <p class="text-[10px] uppercase tracking-wider text-zinc-500">Wins</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="space-y-2">
      <TeamMembershipButton
        client:visible
        teamId={team.id}
        teamName={team.name}
        userCurrentTeamId={userCurrentTeamId}
        isAuthenticated={isAuthenticated}
      />
      <a
        href={`/teams/${team.slug}`}
        class="block text-center text-xs font-semibold text-zinc-400 transition-colors hover:text-white py-1"
      >
        Inspect Faction Roster &rarr;
      </a>
    </div>
  </div>
</article>
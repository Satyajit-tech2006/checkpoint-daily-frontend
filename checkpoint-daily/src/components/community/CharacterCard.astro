---
import type { CharacterProfile } from '../../types';
import { cn } from '../../lib/utils';

interface Props {
  character: CharacterProfile;
}

const { character } = Astro.props;

const statusColors = {
  Active: 'border-emerald-500/40 bg-emerald-500/15 text-emerald-300',
  Wanted: 'border-red-500/40 bg-red-500/15 text-red-300',
  Unknown: 'border-zinc-700 bg-zinc-800/80 text-zinc-300',
};
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-zinc-800/90 bg-[#121216] transition-all hover:border-cyan-500/50">
  <!-- Portrait Container -->
  <div class="relative aspect-[4/5] w-full overflow-hidden bg-zinc-900">
    <img
      src={character.portraitImage}
      alt={`${character.name} dossier portrait`}
      loading="lazy"
      class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-[#121216] via-[#121216]/30 to-transparent"
    />

    <!-- Status Pill -->
    <span
      class={cn(
        'absolute top-3 right-3 rounded border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm',
        statusColors[character.status]
      )}
    >
      {character.status}
    </span>

    <!-- Bottom Overlay Identity -->
    <div class="absolute bottom-3 left-4 right-4">
      <p class="text-[11px] font-bold uppercase tracking-widest text-cyan-400">
        {character.faction}
      </p>
      <h3 class="mt-0.5 font-display text-2xl font-black uppercase tracking-tight text-white group-hover:text-cyan-300 transition-colors">
        <a
          href={`/characters/${character.slug}`}
          class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:underline"
        >
          {character.name}
        </a>
      </h3>
      {character.alias && (
        <p class="text-xs font-medium text-zinc-400">&ldquo;{character.alias}&rdquo;</p>
      )}
    </div>
  </div>

  <!-- Dossier Metadata Footer -->
  <div class="flex flex-1 flex-col justify-between p-4 pt-2 space-y-3">
    <p class="line-clamp-2 text-xs leading-relaxed text-zinc-400">
      {character.bio}
    </p>

    <div class="flex items-center justify-between border-t border-zinc-800/80 pt-3 text-[11px] text-zinc-500">
      <span>{character.role}</span>
      <span class="font-semibold text-zinc-300">{character.location}</span>
    </div>
  </div>
</article>
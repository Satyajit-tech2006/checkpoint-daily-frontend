---
import type { Author } from '../../types';
import { formatEditorialDate, cn } from '../../lib/utils';

interface Props {
  author: Author;
  publishedAt?: string;
  readingTime?: string;
  variant?: 'byline' | 'bio-box';
  className?: string;
}

const {
  author,
  publishedAt,
  readingTime,
  variant = 'byline',
  className,
} = Astro.props;

const initials = author.name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div
  class={cn(
    variant === 'bio-box'
      ? 'rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 sm:p-6'
      : 'flex items-center gap-3.5',
    className
  )}
>
  <div class="flex items-center gap-3.5">
    {author.avatar ? (
      <img
        src={author.avatar}
        alt={author.name}
        loading="lazy"
        class="h-11 w-11 shrink-0 rounded-full border border-zinc-700 object-cover"
      />
    ) : (
      <div
        aria-hidden="true"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-amber-500/30 bg-zinc-900 font-display text-sm font-black text-amber-400"
      >
        {initials}
      </div>
    )}

    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        {author.href ? (
          <a
            href={author.href}
            class="text-sm font-bold text-white transition-colors hover:text-amber-400"
          >
            {author.name}
          </a>
        ) : (
          <span class="text-sm font-bold text-white">{author.name}</span>
        )}
        <span class="rounded bg-zinc-800 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
          {author.role}
        </span>
      </div>

      {(publishedAt || readingTime) && (
        <div class="mt-0.5 flex items-center gap-2 text-xs text-zinc-400">
          {publishedAt && <time datetime={publishedAt}>Published {formatEditorialDate(publishedAt)}</time>}
          {publishedAt && readingTime && <span aria-hidden="true">&bull;</span>}
          {readingTime && <span>{readingTime}</span>}
        </div>
      )}
    </div>
  </div>

  {variant === 'bio-box' && author.bio && (
    <p class="mt-3.5 border-t border-zinc-800/80 pt-3.5 text-sm leading-relaxed text-zinc-400">
      {author.bio}
    </p>
  )}
</div>
---
import type { ArticleSummary } from '../../types';
import TagBadge from './TagBadge.astro';
import ArticleMetadata from './ArticleMetadata.astro';

interface Props {
  article: ArticleSummary;
}

const { article } = Astro.props;
const articleHref = `/articles/${article.slug}`;
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-zinc-800/90 bg-[#121216] transition-colors hover:border-zinc-700">
  <!-- 16:9 Thumbnail -->
  <div class="relative aspect-video w-full overflow-hidden bg-zinc-900">
    <img
      src={article.coverImage}
      alt={article.coverAlt}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-1.5">
      <TagBadge label={article.category} variant="category" />
      {article.rumourStatus && (
        <TagBadge label={article.rumourStatus} variant={article.rumourStatus} />
      )}
    </div>
  </div>

  <!-- Card Body -->
  <div class="flex flex-1 flex-col justify-between p-5 space-y-4">
    <div class="space-y-2">
      <h3 class="font-display text-lg font-bold leading-snug text-zinc-100 transition-colors group-hover:text-amber-400">
        <a
          href={articleHref}
          class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:underline"
        >
          {article.title}
        </a>
      </h3>
      <p class="line-clamp-2 text-sm leading-relaxed text-zinc-400">
        {article.excerpt}
      </p>
    </div>

    <div class="border-t border-zinc-800/70 pt-3">
      <ArticleMetadata
        authorName={article.author.name}
        publishedAt={article.publishedAt}
        readingTime={article.readingTime}
        compact
      />
    </div>
  </div>
</article>
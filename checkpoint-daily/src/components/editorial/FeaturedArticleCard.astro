---
import type { ArticleSummary } from '../../types';
import TagBadge from './TagBadge.astro';
import ArticleMetadata from './ArticleMetadata.astro';

interface Props {
  article: ArticleSummary;
  priority?: boolean;
}

const { article, priority = true } = Astro.props;
const articleHref = `/articles/${article.slug}`;
---

<article class="group relative flex min-h-[380px] sm:min-h-[480px] flex-col justify-end overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900">
  <!-- Background Image -->
  <img
    src={article.coverImage}
    alt={article.coverAlt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
  />

  <!-- Cinematic Contrast Scrim -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/75 to-zinc-950/15"
  />

  <!-- Editorial Content -->
  <div class="relative z-10 p-6 sm:p-8 lg:p-10 max-w-3xl space-y-3.5">
    <div class="flex flex-wrap items-center gap-2">
      <TagBadge label={article.category} variant="category" size="md" />
      {article.rumourStatus && (
        <TagBadge
          label={`Rumour: ${article.rumourStatus}`}
          variant={article.rumourStatus}
          size="md"
        />
      )}
    </div>

    <h1 class="font-display text-2xl font-black leading-tight text-white sm:text-4xl lg:text-[42px]">
      <a
        href={articleHref}
        class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:underline"
      >
        {article.title}
      </a>
    </h1>

    <p class="line-clamp-2 sm:line-clamp-3 text-sm sm:text-base leading-relaxed text-zinc-300">
      {article.excerpt}
    </p>

    <div class="pt-1">
      <ArticleMetadata
        authorName={article.author.name}
        publishedAt={article.publishedAt}
        readingTime={article.readingTime}
      />
    </div>
  </div>
</article>
---
import type { NavItem, SearchableItem } from '../../types';
import PageContainer from './PageContainer.astro';
import DesktopNav from './DesktopNav.astro';
import MobileNav from './MobileNav';
import SearchComponent from '../navigation/SearchComponent';
import LiveHeaderAuth from '../community/LiveHeaderAuth';

interface Props {
  navItems?: NavItem[];
  currentPath?: string;
  searchItems?: SearchableItem[];
}

const defaultNavItems: NavItem[] = [
  { label: 'News', href: '/news' },
  { label: 'Explainers', href: '/explainers' },
  { label: 'Rumour Radar', href: '/rumour-radar', badge: 'Live' },
  { label: 'Characters', href: '/characters' },
  { label: 'Teams', href: '/teams', isCommunity: true },
  { label: 'Arena Vote', href: '/vote', badge: 'Weekly', isCommunity: true },
  { label: 'Leaderboard', href: '/leaderboard', isCommunity: true },
];

const {
  navItems = defaultNavItems,
  currentPath = Astro.url.pathname,
  searchItems = [],
} = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-zinc-800/90 bg-zinc-950/90 backdrop-blur-md">
  <PageContainer className="flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="group flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded-md"
      aria-label="Checkpoint Daily Home"
    >
      <div class="relative flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-700 bg-zinc-900 shadow-inner transition-colors group-hover:border-amber-500/60">
        <span class="h-3.5 w-3.5 rotate-45 border-2 border-amber-500 bg-amber-500/20 transition-transform duration-300 group-hover:rotate-90" />
      </div>
      <div class="flex flex-col">
        <span class="font-display text-lg font-black uppercase leading-none tracking-tight text-white">
          Checkpoint <span class="text-amber-500">Daily</span>
        </span>
        <span class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-500">
          Leonida &bull; Dispatch
        </span>
      </div>
    </a>

    <DesktopNav items={navItems} currentPath={currentPath} />

    <div class="flex items-center gap-2.5">
      <SearchComponent client:load items={searchItems} />
      <LiveHeaderAuth client:load />
      <MobileNav client:load items={navItems} currentPath={currentPath} />
    </div>
  </PageContainer>
</header>